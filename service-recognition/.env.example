# gRPC Server
GRPC_PORT=50051

# Go Backend (for recovery)
GO_BACKEND_HOST=backend
GO_BACKEND_PORT=8080

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM=recognition:results

# S3 Storage
S3_ENDPOINT=https://s3.timeweb.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=anpr
S3_USE_SSL=true
S3_REGION=ru-1

# Worker Settings
FRAME_INTERVAL=30                # Process every Nth frame (1fps @ 30fps)
CONFIDENCE_THRESHOLD=0.7         # Minimum confidence for detection
WORKER_RECONNECT_DELAY=5         # Seconds before retry
WORKER_MAX_RETRIES=3             # Maximum reconnection attempts

# ML Models
YOLO_MODEL_PATH=yolov8n.pt
OCR_LANGUAGES=["en", "ru"]
OCR_GPU=false                    # Set to true if GPU is available
