# Настройки gRPC сервера
GRPC_PORT=50051

# Настройки Go Backend
GO_BACKEND_HOST=backend
GO_BACKEND_PORT=8080

# Настройки Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM=recognition:results

# Хранилище S3
S3_ENDPOINT=https://s3.timeweb.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=anpr
S3_USE_SSL=true
S3_REGION=ru-1

# Настройки воркера
FRAME_INTERVAL=30                # Обрабатывать каждый N-й кадр (1 кадр/сек при 30fps)
CONFIDENCE_THRESHOLD=0.7         # Минимальный порог уверенности детекции
WORKER_RECONNECT_DELAY=5         # Задержка перед повторным подключением (сек)
WORKER_MAX_RETRIES=3             # Максимальное число попыток переподключения

# Пути к ML моделям
YOLO_MODEL_PATH=yolov8n.pt
OCR_LANGUAGES=["en", "ru"]
OCR_GPU=false                    # Установить true при наличии GPU
