# Backend (Go)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSL=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=anpr:results

GRPC_HOST=localhost
GRPC_PORT=50051

HTTP_PORT=8080

ADMIN_USER=admin
ADMIN_PASSWORD=changeme

S3_ENDPOINT=https://s3.timeweb.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=anpr
S3_USE_SSL=true
S3_REGION=ru-1

# Service Recognition (Python)
GRPC_PORT=50051

GO_BACKEND_HOST=backend
GO_BACKEND_PORT=8080

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=anpr:results

S3_ENDPOINT=https://s3.timeweb.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=anpr
S3_USE_SSL=true
S3_REGION=ru-1

FRAME_INTERVAL=1
CONFIDENCE_THRESHOLD=0.5
WORKER_RECONNECT_DELAY=5
WORKER_MAX_RETRIES=3

YOLO_MODEL_PATH=models/yolov8n_plate_detector/best.pt
CRNN_MODEL_PATH=models/crnn_number_detector_weights/crnn_plate_best.pth

PLATE_PATTERN=^[ABEKMHOPCTYX]\d{3}[ABEKMHOPCTYX]{2}\d{2}$
