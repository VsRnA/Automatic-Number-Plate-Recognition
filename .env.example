ENV=development
LOG_LEVEL=info

# HTTP (Go Backend)
HTTP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anpr
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SSL=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=recognition:results

# gRPC
GRPC_HOST=localhost
GRPC_PORT=50051

# S3 Storage (TimeWeb / MinIO)
S3_ENDPOINT=https://s3.timeweb.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name
S3_USE_SSL=true
S3_REGION=ru-1

# Auth (Go Backend)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Python Recognition Service
GO_BACKEND_HOST=localhost
GO_BACKEND_PORT=8080
CONFIDENCE_THRESHOLD=0.5
WORKER_RECONNECT_DELAY=5
WORKER_MAX_RETRIES=3
ROI_ENABLED=false
PLATE_DETECTOR_IMGSZ=640
PLATE_DETECTOR_MODEL_PATH=models/yolov8n_plate_detector/best.pt
CRNN_MODEL_PATH=models/crnn_number_detector_weights/crnn_plate_best.pth
CRNN_DEVICE=cpu
