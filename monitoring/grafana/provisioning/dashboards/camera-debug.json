{
  "id": null,
  "uid": "anpr-camera-debug",
  "title": "Camera Debug",
  "tags": ["anpr"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "camera_id",
        "label": "Camera ID",
        "type": "textbox",
        "current": { "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "All Events — camera: $camera_id",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"service-recognition\"} | json | camera_id=\"$camera_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Silent Failures (отклонённые номера) — camera: $camera_id",
      "description": "Все события, по которым номер не был распознан: низкий confidence, маленький размер, неверный формат OCR, cooldown трекера",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"service-recognition\"} | json | camera_id=\"$camera_id\" | event=~\"plate_filtered.*|plate_rejected.*|plate_crop.*|tracker_.*|stream_.*|rtsp_.*|s3_.*\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Confirmed Plates — camera: $camera_id",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"service-recognition\"} | json | camera_id=\"$camera_id\" | event=~\"plate_confirmed|track_confirmed\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
