# Настройки базы данных
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSL=disable

# Настройки Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=anpr:results

# Настройки gRPC
GRPC_HOST=localhost
GRPC_PORT=50051

# Хранилище S3 (TimeWeb S3)
S3_ENDPOINT=your_s3_endpoint
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=anpr
S3_USE_SSL=true
S3_REGION=ru-1
